export CUDA_VISIBLE_DEVICES=0,1,2,3
export RAY_TMPDIR=""
export SWANLAB_API_KEY=""

PROJECT_DIR="$(pwd)"
CONFIG_PATH="$PROJECT_DIR/examples/sglang_multiturn/config"
TOOL_CONFIG="$CONFIG_PATH/tool_config/search_tool_config.yaml"


PROJECT_NAME=''
EXPERIMENT_NAME=''

TRAIN_DATA_PATH=""
TEST_DATA_PATH=""

# 是否选用 spr1 模型
# MODEL_PATH=""
MODEL_PATH="" # 新增了 tag 作为 token

# OLE part
export PPO_USE_OLE=0 # 1 为启用 OLE
export PPO_OLE_THRESHOLD_PERCENT=0.4
export PPO_OLE_INIT_THRESHOLD=0.0
export PPO_OLE_K=1.0

# decoupling part
export DECOUPLING=0 # 是否启用 decoupling

# agent loop part
export AGENT_LOOP=spr1_agent # 可以选择 spr1_agent 或 tool_agent
# 如果选择 spr1_agent, 可以调节
export USE_4D_MASK=0
export SPR1_PARALLEL_SEARCH_NUM_PATHS=3
export SPR1_MAX_ONE_STEP_LENGTH=128
export SPR1_MAX_NUM_TURNS=10

# reward part
export REWARD_MANAGER=naive_process
export CUSTOM_REWARD_FUNCTION_PATH="verl/utils/reward_score/sp_r1_process_reward.py"
export CUSTOM_REWARD_FUNCTION_NAME="compute_score"

# 是否启动 4d mask
export USE_4D_MASK=0

